{
	"name": "mcp",
	"version": "0.1.0",
	"private": true,
	"description": "Log forensics MCP server",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"build": "XMCP_TELEMETRY_DISABLED=true xmcp build",
		"dev": "XMCP_TELEMETRY_DISABLED=true xmcp dev",
		"start": "node dist/http.js",
		"check-types": "tsgo --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"csv-plugin": "workspace:*",
		"evtx-plugin": "workspace:*",
		"journal-plugin": "workspace:*",
		"pcap-plugin": "workspace:*",
		"plaintext-plugin": "workspace:*",
		"reg-plugin": "workspace:*",
		"xmcp": "1.1.3",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@rspack/core": "^1.7.12",
		"typescript": "^7",
		"@xmcp-dev/compiler": "1.1.3"
	}
}
