{
	"name": "log-forensics-mcp",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"bundle": "turbo run build && bun build --compile --outfile dist/log-forensics-mcp apps/mcp/dist/http.js",
		"dev": "turbo run dev",
		"start": "turbo run start",
		"check-types": "turbo run check-types",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@changesets/cli": "^3.0.2",
		"@types/node": "^26.5.1",
		"turbo": "^2.10.12"
	}
}
