{
	"name": "log-forensics-mcp",
	"version": "0.2.1",
	"description": "MCP server for log forensics. Allows searching and reading supported log files.",
	"license": "SEE LICENSE IN LICENSE",
	"repository": "github:SebassNoob/log-forensics-mcp",
	"packageManager": "bun@1.3.14",
	"bin": {
		"log-forensics-mcp": "./bin.mjs"
	},
	"files": [
		"bin.mjs"
	],
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"bundle": "turbo run build && bun build --compile --outfile dist/log-forensics-mcp apps/mcp/dist/http.js",
		"dev": "turbo run dev",
		"start": "turbo run start",
		"check-types": "turbo run check-types",
		"lint": "turbo run lint",
		"format": "turbo run format"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@changesets/cli": "^3.0.2",
		"@types/node": "^26.5.1",
		"turbo": "^2.11.2"
	}
}
